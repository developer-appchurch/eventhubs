# EventHubs · variáveis de ambiente
# Copie este arquivo para .env.local (desenvolvimento) e preencha. Nunca versione valores reais.
# Consulte docs/configuracao.md para o passo a passo de cada variável.

# URL pública da aplicação, sem barra final. Usada em e-mails de confirmação e redirecionamentos.
# Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# URL da API do projeto Supabase do EventHubs. Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável do Supabase (formato sb_publishable_...). Pode ir ao navegador: só dá
# acesso ao que a RLS permite.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase (sb_secret_...). Somente servidor, nunca NEXT_PUBLIC_. Usada só
# nas funções liberadas a service_role (envio de e-mail); o resto opera com a sessão do usuário.
SUPABASE_SECRET_KEY=

# ── E-mail (opcional). Sem as três variáveis (com a chave acima), nenhum e-mail é enviado.
# Chave de API do Resend (re_...) e remetente num domínio verificado no Resend.
RESEND_API_KEY=
# Exemplo: EventHubs <inscricoes@seudominio.com.br>
EMAIL_FROM=

# Banco local de testes (somente loopback). Usado por `npm run db:reset:local` e `npm run test:db`.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Ainda não integrados: pagamentos e observabilidade.
# Serão documentados quando forem implementados.
